# EduATPH Environment Variables
# Hubungkan dengan Supabase project Anda (bisa didapatkan di https://supabase.com/dashboard/project/_/settings/api)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (Hanya untuk server-side administrative tasks, JANGAN diexpose ke browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API Key untuk Penilaian AI Otomatis (Uraian & Studi Kasus)
# Dijalankan hanya di sisi server (JANGAN gunakan awalan NEXT_PUBLIC_)
# Dapatkan API key di Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Informasi Administrator
NEXT_PUBLIC_ADMIN_NAME="Okta Nofiyanto"
NEXT_PUBLIC_APP_NAME="EduATPH"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
